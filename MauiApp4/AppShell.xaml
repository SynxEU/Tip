<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="MauiApp4.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:MauiApp4"
    Title="MauiApp4"
    Shell.BackgroundColor="#F4F1EA"
    Shell.ForegroundColor="Black"
    FlyoutBackgroundColor="#F4F1EA">
    
    <FlyoutItem Title="Home" Icon="home.svg">
        <ShellContent Title="Home" ContentTemplate="{DataTemplate local:MainPage}" />
    </FlyoutItem>

    <FlyoutItem Title="About" Icon="info.svg">
        <ShellContent Title="About" ContentTemplate="{DataTemplate local:AboutPage}" />
    </FlyoutItem>

    <FlyoutItem Title="Feedback" Icon="feedback.svg">
        <ShellContent Title="Feedback" ContentTemplate="{DataTemplate local:FeedbackPage}" />
    </FlyoutItem>

    <FlyoutItem Title="Restaurants" Icon="restaurant.svg">
        <ShellContent Title="Restaurants" ContentTemplate="{DataTemplate local:RestaurantsPage}" />
    </FlyoutItem>

    <FlyoutItem Title="Settings" Icon="cog.svg">
        <ShellContent Title="Settings" ContentTemplate="{DataTemplate local:SettingsPage}" />
    </FlyoutItem>

</Shell>
